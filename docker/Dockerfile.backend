# syntax=docker/dockerfile:1

# ─── Stage 1: Build frontend ───
FROM node:22-bookworm AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ─── Stage 2: Build Rust backend ───
FROM rust:1.80-bookworm AS backend-builder

WORKDIR /app
COPY Cargo.toml rust-toolchain.toml ./
COPY crates/*/Cargo.toml ./crates/*/

# Create stub lib.rs/main.rs so cargo can resolve dependencies
RUN mkdir -p crates/gateway-api/src && echo 'fn main() {}' > crates/gateway-api/src/main.rs
RUN for crate in gateway-core gateway-providers gateway-cache gateway-quota gateway-auth gateway-db gateway-observability; do \
    mkdir -p crates/$crate/src && echo '' > crates/$crate/src/lib.rs; \
    done
RUN cargo build --release --bin gateway-api 2>/dev/null || true

# Now copy real source and build
COPY crates/ ./crates/
RUN cargo build --release --bin gateway-api

# ─── Stage 3: Runtime ───
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend binary
COPY --from=backend-builder /app/target/release/gateway-api /usr/local/bin/gateway-api

# Copy built frontend assets
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

EXPOSE 8080

ENV APP_ENV=production

ENTRYPOINT ["gateway-api"]
CMD ["serve"]
